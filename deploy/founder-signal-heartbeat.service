[Unit]
Description=Founder Signal heartbeat (fetch new email via himalaya)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Set WorkingDirectory to your Founder Signal checkout, e.g.:
# WorkingDirectory=/home/yourname/founder-signal
# Or set FOUNDER_SIGNAL_HOME in the EnvironmentFile below and use a wrapper.
WorkingDirectory=/opt/founder-signal
EnvironmentFile=-/opt/founder-signal/.env
ExecStart=/usr/bin/python3 -m founder_signal.cli heartbeat --accounts zoho,gmail

[Install]
WantedBy=multi-user.target
