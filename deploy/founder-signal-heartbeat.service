[Unit]
Description=Founder Signal heartbeat (fetch new email via himalaya)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Recommended: Deploy as a user service in ~/.config/systemd/user/
# If deployed system-wide in /etc/systemd/system/, uncomment and set User:
# User=yourname
WorkingDirectory=/home/anthony/Projects/founder-signal
EnvironmentFile=-/home/anthony/Projects/founder-signal/.env
Environment="PATH=/home/anthony/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 -m founder_signal.cli heartbeat --accounts zoho,gmail

[Install]
WantedBy=default.target
