# Founder Signal configuration
# Copy to .env and adjust for your environment.

# Ledger backend: "sqlite" (default, local demo) or "mongodb" (MongoDB Atlas)
LEDGER_BACKEND=sqlite

# SQLite path (used when LEDGER_BACKEND=sqlite)
LEDGER_SQLITE_PATH=data/founder_signal.db

# MongoDB Atlas connection string (used when LEDGER_BACKEND=mongodb)
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DATABASE=founder_signal

# Hermes integration (optional). When set, the Founder Signal skill is exposed
# as a Hermes skill endpoint; otherwise run standalone via `python -m founder_signal.cli`.
HERMES_SKILL_ENDPOINT=http://127.0.0.1:8765/skills/founder-signal

# Web UI
WEB_HOST=127.0.0.1
WEB_PORT=5000

# Briefing window (days) for "Coming up" section
BRIEFING_COMING_UP_DAYS=7

# Ollama (local, privacy-first LLM extraction)
# OLLAMA_HOST=http://localhost:11434
# FOUNDER_SIGNAL_MODEL=gemma4:e2b-it-qat
# FOUNDER_SIGNAL_USE_LLM=false

# Founder identity (used to identify commitments directed at you)
# FOUNDER_NAME=Anthony
# FOUNDER_EMAIL=anthony@example.com

# Per-account founder identity (overrides global for specific himalaya accounts)
# Format: FOUNDER_NAME_<ACCOUNT> and FOUNDER_EMAIL_<ACCOUNT>
# Example for zoho and gmail accounts:
# FOUNDER_NAME_ZOHO=Anthony
# FOUNDER_EMAIL_ZOHO=anthony@zohomail.com
# FOUNDER_NAME_GMAIL=Anthony
# FOUNDER_EMAIL_GMAIL=anthony@gmail.com

# Inbox folder (watcher scans this folder for new files to ingest)
# Default: ~/Downloads/founder-signal-inbox
# FOUNDER_SIGNAL_INBOX=~/Downloads/founder-signal-inbox

# Web upload limits
# FOUNDER_SIGNAL_MAX_UPLOAD_MB=25
# FOUNDER_SIGNAL_UPLOAD_EXTENSIONS=txt,md,mp3,wav,m4a,ogg,aac
